# Generated / installed artifacts only. Everything authored in this repo is committed,
# including the AI protocol files (CLAUDE.md, AGENTS.md, .claude/, .agents/) and ai/.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# storybook
storybook-static
*storybook.log

# responsive scan: raw full-page screenshots are regenerated on every run and never enter history;
# only docs/responsive-report.md (table) and docs/responsive-report.png (11-width composite) are committed
/docs/responsive-shots/

# typescript (regenerated by next)
*.tsbuildinfo
next-env.d.ts

# env files: real values never enter the repo; .env.example documents them
.env*
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / IDE
.DS_Store
.idea/
.vscode/
*.pem
.vercel
